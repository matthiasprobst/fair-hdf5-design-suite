# Copy desired overrides into .env. Environment variables take precedence.
# Relative paths resolve from the project root. Restart after changes.
FAIR_HDF5_HOST=127.0.0.1
FAIR_HDF5_PORT=8000
FAIR_HDF5_LOG_LEVEL=info
FAIR_HDF5_SERVE_FRONTEND=true
FAIR_HDF5_FRONTEND_DIST=frontend/dist
# Unset uses the operating system temporary directory. Must exist and be writable.
# FAIR_HDF5_TEMP_DIR=/tmp
FAIR_HDF5_SHACL_ENGINE=pyshacl
FAIR_HDF5_MAX_UPLOAD_BYTES=30000000
FAIR_HDF5_MAX_NODES=250
FAIR_HDF5_MAX_EDGES=1000
FAIR_HDF5_MAX_METADATA_LENGTH=3000
FAIR_HDF5_MAX_DATASET_DIMENSIONS=5
FAIR_HDF5_MAX_DIMENSION_SIZE=50000
FAIR_HDF5_MAX_DATASET_ELEMENTS=2000000
FAIR_HDF5_MAX_REPORT_ISSUES=250
# Development-only Vite proxy override; never included in the client bundle.
# FAIR_HDF5_API_TARGET=http://127.0.0.1:8000

# Persistent, installation-wide SHACL catalog (relative to repository root).
FAIR_HDF5_DATA_DIR=data

# Team projects, local accounts and editing reservations.
# Keep public URL unset for localhost development. Set it to the exact HTTPS
# origin on a team server, with secure cookies enabled.
# FAIR_HDF5_PUBLIC_URL=https://design.example.org
FAIR_HDF5_COOKIE_SECURE=false
FAIR_HDF5_SESSION_SECONDS=43200
# Minimum length for newly set passwords (3–128). Use 3 for local testing.
FAIR_HDF5_PASSWORD_MIN_LENGTH=15
FAIR_HDF5_EDIT_LOCK_SECONDS=120
FAIR_HDF5_MAX_BLUEPRINT_BYTES=33554432

# Bounded SHACL dependency retrieval (only during explicit import analysis).
FAIR_HDF5_PROFILE_FETCH_TIMEOUT=10
FAIR_HDF5_PROFILE_MAX_REDIRECTS=5
FAIR_HDF5_PROFILE_MAX_DEPTH=8
FAIR_HDF5_PROFILE_MAX_DOCUMENTS=16
FAIR_HDF5_PROFILE_MAX_DOCUMENT_BYTES=1000000
FAIR_HDF5_PROFILE_MAX_TOTAL_BYTES=8000000
