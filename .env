# Copy to .env. Choose a long random alphanumeric secret before starting.
# Alphanumeric avoids URL encoding in DATABASE_URL constructed by Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
AUTH_MODE=local
PUBLIC_BASE_URL=http://localhost:8000

# Institutional installation (AUTH_MODE=oidc):
# PUBLIC_BASE_URL=https://design.example.org
# OIDC_DISCOVERY_URL=https://identity.example.org/realms/research/.well-known/openid-configuration
# OIDC_CLIENT_ID=fair-hdf5-design-suite
# OIDC_CLIENT_SECRET=
