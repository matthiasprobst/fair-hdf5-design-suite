@prefix dash: <http://datashapes.org/dash#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix m4i: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix aps: <https://w3id.org/nfdi4ing/profiles/> .

<https://w3id.org/nfdi4ing/profiles/56aebc37-dbb9-4a02-9cb8-1b7f58c2b91a/> dcterms:created "2025-10-08"^^xsd:date ;
	dcterms:creator "Metadata4Ing" ;
	dcterms:description "A research project"@en, "Ein Forschungsprojekt"@de ;
	dcterms:license <http://spdx.org/licenses/CC0-1.0> ;
	dcterms:title "m4i Research Project"@en, "m4i Forschungsprojekt"@de ;
	a sh:NodeShape ;
	owl:imports <https://w3id.org/nfdi4ing/profiles/b836ad06-e1d0-4287-a182-66de74e98eee/>, <https://w3id.org/nfdi4ing/profiles/e18a558c-03a2-4a89-9cfb-656aad6f6644/1767883664018/> ;
	sh:closed false ;
	sh:property [
		sh:datatype xsd:date ;
		sh:maxCount 1 ;
		sh:order 7 ;
		sh:path m4i:endOfProject ;
		sh:name "has end date"@en ;
	], [
		sh:datatype xsd:string ;
		sh:maxCount 1 ;
		sh:order 1 ;
		sh:path rdfs:label ;
		sh:name "name"@en ;
		sh:minCount 1 ;
	], [
		sh:order 5 ;
		sh:path m4i:projectParticipant ;
		sh:name "has participating organization"@en ;
		sh:qualifiedValueShape <https://w3id.org/nfdi4ing/profiles/b836ad06-e1d0-4287-a182-66de74e98eee/> ;
	], [
		sh:datatype xsd:date ;
		sh:maxCount 1 ;
		sh:order 6 ;
		sh:path m4i:startOfProject ;
		sh:name "has start date"@en ;
	], [
		sh:order 4 ;
		sh:path m4i:projectParticipant ;
		sh:name "has participating person"@en ;
		sh:qualifiedValueShape <https://w3id.org/nfdi4ing/profiles/e18a558c-03a2-4a89-9cfb-656aad6f6644/1767883664018/> ;
	], [
		sh:datatype xsd:string ;
		sh:maxCount 1 ;
		sh:order 2 ;
		sh:path schema:description ;
		sh:name "description"@en ;
		dash:singleLine false ;
	], [
		sh:datatype xsd:string ;
		sh:maxCount 1 ;
		sh:order 3 ;
		sh:path m4i:projectReferenceID ;
		sh:name "has project ID"@en ;
		sh:minCount 1 ;
	] ;
	sh:targetClass <https://schema.org/ResearchProject> .

